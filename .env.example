# ==============================================================================
# RAISEIT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server & Port Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection
# Example: mongodb://localhost:27017/raiseit or MongoDB Atlas URI
MONGODB_URI=mongodb://localhost:27017/raiseit

# Authentication Secrets
JWT_SECRET=super_secret_raiseit_jwt_key_development_2026
JWT_EXPIRES_IN=7d

# Image Storage (Cloudinary) - Optional: local disk storage used if left empty
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Service (FastAPI)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_INTERNAL_KEY=raiseit_internal_ai_secret_token

# LLM & Embedding Settings for RAG
# Leave LLM_API_KEY empty to use deterministic verified document excerpt synthesis
LLM_PROVIDER=huggingface_or_openai
LLM_API_KEY=
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./chroma_db
TOP_K_RETRIEVAL=5

# Priority Engine Defaults
DEFAULT_RECURRENCE_RADIUS_METERS=500
DEFAULT_RECURRENCE_TIME_WINDOW_DAYS=30
PRIORITY_THRESHOLD_LOW=40
PRIORITY_THRESHOLD_HIGH=70
